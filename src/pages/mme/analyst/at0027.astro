---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "李苔菁";
const mimg = "/images/analyst/at0027.jpg";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "無尾熊潛能開發中心LASY積木.桌遊講師15年",
  "台灣兒童發展協會課程講師",
  "海星國小寒暑期桌遊營隊講師",
  "台灣兒童暨家庭扶助基金會親子共學課程兒童課程講師",
  "中華民國救世慈善協會寒暑期潛能開發課程講師",
  "洄瀾親子館多元文化教育課程外聘講師",
  "家扶保母資源中心志工培訓LASY積木講師",
  "禪光育幼院潛能開發講師",
  "幼兒潛能開發/研發桌遊設計與輔導"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1982.03.11"}
  imageWidth={577}
  imageHeight={763}
/>
