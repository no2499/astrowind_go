---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "劉文龍 Jeffery 1957.09.05";
const mimg = "/images/analyst/at0018.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "( Email: drjeffery0905@gmail.com )",
  "MME副會長，藉由MME皮紋學清晰解讀大腦的先天思維特質，樂助有心提昇生活與工作效率者，啟動全力以赴行動熱情，體驗更卓越的事業成就；協力教養者發揮學童『心智優勢』結合因材施教輔導策略，感受幸福家庭，擁抱豐盛生活與工作成果!",
  "主管職務經歷: 飛行線、飛安管理、人事經管、團隊技能訓練、督導考核管理、資訊研析管理",
  "MME高階行為諮詢師暨專題研究",
  "曾任飛行人員訓練暨學習策略專業顧問",
  "長期行為引導公益講座(青少年書屋、善童班、松鶴班)",
  "指引領域：情緒管理、教養關係、體質保健、人際溝通、學習力、專注力、執行力評估、專業優勢技能評估",
  "2010MME 皮紋學論文集 (主題: 飛行員人格特質之研究 )",
  "2018MME 論文集發表會 (主題: 看到了!視覺與生命的意義 )"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  imageWidth={903}
  imageHeight={1027}
/>
