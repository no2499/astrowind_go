---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "潘美慧";
const mimg = "/images/analyst/at0009.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "英語教學30年師資培訓講師25年/培訓業運營25年",
  "兩岸五地專題研究員/新北市政府專案講師",
  "補教協會專案講師/幼教協會專案講師",
  "遊戲化高效能團隊賦能教練",
  "腦力測評高階分析師",
  "管理系統測試工程師",
  "腦力賦能教練-(一對一、團隊培訓)",
  "外籍移工與長期照護教練陪伴",
  "幼兒、兒童英語教學/英語師資培訓/",
  "2022 讓孩子爭氣你很神氣的親子繪畫樹(親子動力)",
  "2010MME 皮紋學論文集 (腦認知與外語學習)",
  "2013MME 膚紋學論文集 (腦認知與外語學習策略輔導)",
  "2018MME 論文集發表者 (繪畫分析)",
  "公務人員 地方行政研習E學中心邀稿",
  "幼教企管專欄作者",
  "劍橋大學  University of Cambridge ESOL Examination TKT:PRACTICAL認證"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1970.07.14"}
  imageWidth={1046}
  imageHeight={1568}
/>
