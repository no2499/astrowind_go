---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "蔡淑蔚";
const mimg = "/images/analyst/at0006.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "專長：彈琴、LC指引、玩遊戲、蒙特梭利教學、皮紋諮商師、親子溝通",
  "學歷：大學",
  "經歷：奧福音樂老師、幼教老師、園長、喬喬補習班負責人、皮紋論文發表、陽光家庭教練、嬰幼兒按摩老師"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1970.06.08"}
  imageWidth={1148}
  imageHeight={1428}
/>
