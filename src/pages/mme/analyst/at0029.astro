---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "蔡淑瑩";
const mimg = "/images/analyst/at0029.jpg";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "國際AMS蒙特梭利0-3歲，3-6 歲培訓師",
  "AMI 國際蒙特梭利 0-3歲，3-6 歲合格指導員",
  "現任兩岸多所知名蒙特梭利幼兒園督導",
  "台灣國際嬰幼兒按摩協會講師",
  "成大STEAM初階科學師資認證",
  "著作：",
  "《威茵頌幼兒音樂教本》",
  "《蒙特梭利 3—6 歲 Q&A》",
  "《蒙特梭利新父母口袋書》"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1958.03.21"}
  imageWidth={698}
  imageHeight={698}
/>
