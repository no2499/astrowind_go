---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "胡秀瑜";
const mimg = "/images/analyst/at0015.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "幼兒教育工作30年以上",
  "學歷：幼兒教育碩士",
  "經歷：幼兒園教師、園長、幼兒教育學系兼任講師",
  "目前從事工作：幼兒教育.自家果園經營"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1967.02.04"}
  imageWidth={636}
  imageHeight={825}
/>
