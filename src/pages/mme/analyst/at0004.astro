---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "范姜之秀";
const mimg = "/images/analyst/at0004.jpg";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "是一位認真，有愛，體貼，有力量的專業皮紋諮商師",
  "透過指掌紋幫助上千人認識自己，了解學習優勢，開啟學習自信。",
  "不是人生勝利組，但有一顆執著充滿愛的心。",
  "李小龍說過，我不怕練過一萬種踢法的人，只怕將一種踢法練過一萬次的人。",
  "兒童數學教育25年，皮紋諮商20年，發揮可能性，整合資源，創造豐盛成果。",
  "人的大腦不要勉強，他的腦會自己找到出路。",
  "個人數學工作室 負責人",
  "MME 量身教育研究會 腦評恆 高階分析師",
  "2006 皮紋檢測應用於數學智能研究 發表"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " Serena Fan Chiang  1967.10.31"}
  imageWidth={699}
  imageHeight={818}
/>
