---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "李玉婷";
const mimg = "/images/analyst/at0022.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "畢業於實踐大學國際貿易系，",
  "從事銀行業務，有16年完整的銀行專業經歷。",
  "任職於國泰世華銀行，喜歡與人互動，",
  "2018年畢業於ACMA學院的國際績效教練。",
  "專長在皮紋與指引的整合。nt16655@cathaybk.com",
  "工作服務項目：信用卡、基金、保險、證券、基金理財、房貸、小信"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1981.05.07"}
  imageWidth={504}
  imageHeight={603}
/>
