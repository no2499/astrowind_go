---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "賴敏傑";
const mimg = "/images/analyst/at0030.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "蒙特梭利CMF師資結訓",
  "國際嬰幼兒按摩協會IAIM師資結訓",
  "新竹教育大學園長教育訓練合格",
  "課後照顧與輔導師資結訓",
  "培基文教基金會-品格教育師合格",
  "卡內基-親子溝通技巧證書",
  "經歷：",
  "MME中華量身教育國際研究會皮指紋分析師及繪畫分析師",
  "江婦產科嬰幼兒按摩講師",
  "社區講座-蒙氏與家庭的結合講師",
  "東莒國小附幼特聘講師",
  "竹南李科永圖書館親子律動講師",
  "丰之樂人文教育館體能講師",
  "至愛服務協會愛心課輔列車師資培訓講師",
  "論文發表：",
  "2013年皮紋學用於醫學、教育、心理三合一整合探討論文大會",
  "2018年兩岸膚紋學論文發表大會-廈門會議"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1982.09.05"}
  imageWidth={306}
  imageHeight={349}
/>
