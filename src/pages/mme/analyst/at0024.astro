---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "王娟娟";
const mimg = "/images/analyst/at0024.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "淡江企管系畢業",
  "腦力開發教室 老師",
  "數學家教老師"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " Judy 1965.02.22"}
  imageWidth={1079}
  imageHeight={1516}
/>
