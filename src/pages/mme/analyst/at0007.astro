---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "曾春梅";
const mimg = "/images/analyst/at0007.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "1.自我專長-MME皮指紋分析（家庭諮商）",
  "2.學經歷-中台科技大學幼保系畢、曾任職台北市幼天才蒙特梭利幼兒園、新北市新佳美主題教學幼兒園、台中愛兒園角落教學幼兒園、全職家庭主婦。",
  "3.目前從事工作-專職MME研究員&分析師。"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1975.02.19"}
  imageWidth={288}
  imageHeight={390}
/>
