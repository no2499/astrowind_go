---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "張素嫻";
const mimg = "/images/analyst/ah0001.gif";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "特殊學校任教21年",
  "MME高階研究員",
  "香港晨輝特教學校老師",
  "MME研究者輔導師"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  imageWidth={1584}
  imageHeight={1990}
/>
