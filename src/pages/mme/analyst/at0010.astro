---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "黃鈴諭";
const mimg = "/images/analyst/at0010.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "1.自我專長",
  "個別化教育計畫擬定",
  "實驗教育諮詢",
  "2.學經歷",
  "東海大學法律系",
  "法務人員",
  "財團法人人本教育文教基金會父母成長班小組長、活動企劃、數學想想國教師",
  "羽白群學行政、高年級導師 2017~2018",
  "社團法人羽白群學學會秘書長 2017~2018",
  "3.目前從事工作",
  "學校型態、非學校型態實驗教育審議會委員",
  "社團法人中華民國振鐸學會秘書",
  "實驗教育工作者/教師",
  "4.服務網站聯結 Email：braincoachtw@gmail.com"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1977.01.16"}
  imageWidth={1124}
  imageHeight={1482}
/>
