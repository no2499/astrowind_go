---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "劉祐瑋";
const mimg = "/images/analyst/at0031.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "任職：錠嵂保險經紀人 區經理",
  "年資：15年",
  "畢業學校：淡江大學 保險系畢",
  "目前有證照：",
  "人身保險",
  "財產保險",
  "外幣非投資型",
  "投資型",
  "FchFP財務特許顧問師",
  "家族傳承財務規劃師",
  "信託專業業務人員",
  "興趣：健身、閱讀、演講",
  "以皮紋工具幫助保險業者有更優質的職業素養"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1986.11.02"}
  imageWidth={1142}
  imageHeight={1435}
/>
