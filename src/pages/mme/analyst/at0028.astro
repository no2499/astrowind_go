---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "黃惠梅";
const mimg = "/images/analyst/at0028.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "一、自我專長",
  "服裝設計、服裝打版、穿搭教學、腦神經心理對色彩的暗示與服飾上的運用",
  "二、學經歷",
  "1.畢業於國立宜蘭頭城家商服裝科",
  "2.西元2000創立塔圖國際開發有限公司",
  "主要業務為承接國內專櫃品牌的設計及生產(ODM)，以接單形式經營逾20年。",
  "3.西元2019年創立網路品牌HAVE",
  "三、目前從事工作",
  "自營網路品牌～HAVE",
  "四.服務網站聯結",
  "https://www.have2019.com/"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " May 1973.2.26"}
  imageWidth={946}
  imageHeight={1493}
/>
