---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "呂玉娟";
const mimg = "/images/analyst/at0005.jpg";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "現任:",
  "何嘉仁LASY建構積木講師",
  "來得幼兒園講師",
  "高爾工作室負責人",
  "曾任:",
  "三峽兔子屋畫室捏塑講師",
  "台北橋幼幼兒園建構積木講師"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1974.11.08"}
  imageWidth={421}
  imageHeight={632}
/>
