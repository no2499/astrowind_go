---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "張珈雯";
const mimg = "/images/analyst/at0023.jpg";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "現職：",
  "思達數學光復創始校、思達數學景美分校、",
  "思達數學板橋分校學齡前兼職教師",
  "中華生活數學推廣學會兼職教師",
  "樂桃桃培訓機構幼兒圖形課程設計暨培訓教師",
  "經歷：",
  "MME研究員",
  "台北市、新北市國小生活數學晨間／課後社團教師",
  "中國杭州幼兒數學培訓教師",
  "著作：",
  "大柱子的生活數學 專題：七巧板",
  "大柱子的生活數學 專題：六形七色版(主題操作篇)",
  "大柱子的生活數學 專題：六形七色版(示範圖庫篇)",
  "思達數學：https://www.fun-123.com/"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1980.07.16"}
  imageWidth={585}
  imageHeight={1039}
/>
