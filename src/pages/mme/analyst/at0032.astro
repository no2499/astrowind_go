---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "游雯伶";
const mimg = "/images/analyst/at0032.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "畢業於聖德基督學院英語系",
  "曾任教於芝麻街美語十六年",
  "MME研究員",
  "創立Smart  Kids",
  "American School於1999年"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " Dior  1964.09.09"}
  imageWidth={808}
  imageHeight={1136}
/>
