---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "薛珮緹";
const mimg = "/images/analyst/at0008.gif";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "園所長資歷25年",
  "蒙特梭利老師25年",
  "蒙特梭利數學培訓師",
  "藝術遊戲治療",
  "情緒的心理治療",
  "MME高階皮紋分析師"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  imageWidth={1045}
  imageHeight={1567}
/>
