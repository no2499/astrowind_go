---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "蘇玲𦰡";
const mimg = "/images/analyst/at0020.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "是一位有敏锐洞悉力、創造力、感染力、對人百分百承诺, 说出做到的專業認證的绩效教練。",
  "RINA 具有豊富的人生歷練和 40年嬰幼兒早教工作經驗。",
  "在親子關係教育、青少年心靈辅导、家庭關係經營和創業規劃、創意行销、誏夢想從零到有～逐步成真是 RINA 的專長",
  "擅用天生直覺力,  透过完全聆聽和提問深度的問題、引领你發現自我潜意識、啓發你在思考上更能創造可能性，不受思维及知識所框架, 易與人有共鸣,",
  "將更能指引你打造自已成為领袖, 有效支持更多人創建卓越的團隊",
  "现任：",
  "致勝力量⋯⋯⋯創辦人",
  "致勝力量⋯⋯⋯客制化企業培訓教練",
  "致勝力量企業及个人指引服務指引教练",
  "台灣台北私立聖儒、聖如～蒙特梭利幼兒園⋯創辦人",
  "日本0-3 歲蒙特梭利教師",
  "義大利3-6歲蒙特梭利教師",
  "義大利6-12歲蒙特梭利教師",
  "經歷：",
  "1985年台灣首創專業母嬰月子中心⋯安琪兒月子中心～首開創辦人",
  "中国北京 、長春～月来悦好 月子中心",
  "企業指引敎練⋯CEO",
  "ACMA 亞洲教練及導師學院國際認證專業绩效教练。",
  "北京大学 企業管理 EMBA",
  "愿景集团三階段课程總教练",
  "中國二級認證心理諮商師",
  "台灣MM E皮指紋認證諮詢師",
  "兒童左右腦開發訓練指導老師",
  "國際芳香精油療法認證芳療師"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " RINA 1961.09.27"}
  imageWidth={614}
  imageHeight={772}
/>
