---
import { SITE } from '~/config.mjs';
import Layout from '~/layouts/PageLayout.astro';

const mname = "a";
const mimg = "/images/analyst/ah0007.jpg";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  {
    title: '健腦操與學習發展',
    items: [
      '國際大腦韻律運動導師及顧問 (RMTi)',
      '特殊教育之丹尼遜健腦操®導師及顧問 (大中華區首位導師)',
      '丹尼遜健腦操®導師及顧問 (教育肌應學基金會)',
      '丹尼遜健腦操26式培訓導師',
      '最佳腦組織模式導師 (教育肌應學基金會)',
      '對稱塗鴉遊戲導師 (教育肌應學基金會)',
      '視覺圈導師 (教育肌應學基金會)',
    ],
  },
  {
    title: '兒童發展與專業培訓',
    items: [
      '世界中醫藥聯合會植物精油療法高級講師',
      '國際嬰幼兒按摩導師 (國際嬰幼兒按摩協會)',
      '兒童成長治療專業文憑 (香港中文大學專業進修學院)',
      '沙維雅家庭治療模式證書課程',
      '感覺統合運動師 (美國心理學會)',
      '美國丹佛DENVER II 兒童發展評量技術員 (DDST II)',
    ],
  },
];
---

<Layout {meta}>
  <article class="bg-slate-50 px-5 py-10 dark:bg-slate-900 sm:px-8 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <a
        href="/mme/analyst"
        class="mb-8 inline-flex items-center gap-2 rounded text-sm font-medium text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 dark:text-blue-300"
      >
        <span aria-hidden="true">←</span> 返回分析師列表
      </a>

      <header class="grid items-center gap-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-10 md:grid-cols-[280px_1fr] md:gap-12">
        <img
          src={mimg}
          alt={`${mname}的個人照片`}
          width="1045"
          height="1567"
          class="mx-auto h-auto w-full max-w-[280px] rounded-2xl"
        />
        <div class="text-center md:text-left">
          <p class="mb-3 text-sm font-semibold tracking-widest text-primary dark:text-blue-300">分析師介紹</p>
          <h1 class="mb-5 text-4xl font-bold leading-tight text-slate-900 dark:text-white sm:text-5xl">{mname}</h1>
          <p class="text-lg leading-relaxed text-slate-600 dark:text-slate-300">咨達國際有限公司創辦人</p>
          <p class="mt-5 inline-block rounded-full bg-blue-50 px-4 py-2 text-sm font-medium text-primary dark:bg-blue-950 dark:text-blue-200">
            MME 資深皮紋分析師
          </p>
        </div>
      </header>

      <section aria-labelledby="qualifications-heading" class="mt-12">
        <h2 id="qualifications-heading" class="mb-6 text-2xl font-bold text-slate-900 dark:text-white">專業背景與資歷</h2>
        <div class="grid gap-6 md:grid-cols-2">
          {qualifications.map((group) => (
            <section class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800 sm:p-8">
              <h3 class="mb-5 border-b border-slate-100 pb-4 text-lg font-semibold text-primary dark:border-slate-700 dark:text-blue-300">{group.title}</h3>
              <ul class="space-y-4">
                {group.items.map((item) => (
                  <li class="flex gap-3 text-base leading-7 text-slate-600 dark:text-slate-300">
                    <span aria-hidden="true" class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-400" />
                    <span class="min-w-0 break-words">{item}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
    </div>
  </article>
</Layout>
