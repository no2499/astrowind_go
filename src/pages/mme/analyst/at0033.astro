---
import { SITE } from '~/config.mjs';
import AnalystProfile from '~/components/common/AnalystProfile.astro';

const mname = "蔡宜芳";
const mimg = "/images/analyst/at0033.png";
const mytitle = "分析師:"+mname;
const meta = {
  title: SITE.title + " {" + mytitle + "}",
  link: SITE.description,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const qualifications = [
  "金門的MME服務",
  "國中的特教生輔導、金城國中青少年輔導、",
  "金門少年觀護所的服務",
  "金門經營事業項目",
  "金門淳新特產行",
  "廈門三元富通有限公司",
  "金鴻福有限公司",
  "通恆租車",
  "微風海戀民宿"
];
---

<AnalystProfile
  name={mname}
  image={mimg}
  {meta}
  {qualifications}
  displayName={mname + " 1968.03.08"}
  imageWidth={357}
  imageHeight={445}
/>
