---
import Layout from '~/layouts/PageLayout.astro';
import type { MetaSEO } from '~/types';

export interface Props {
  name: string;
  image: string;
  qualifications: string[];
  meta?: MetaSEO;
  displayName?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  name,
  image,
  qualifications,
  meta,
  displayName = name,
  imageWidth,
  imageHeight,
} = Astro.props;

const hasNamePrefix = name && displayName.startsWith(name);
const headingName = hasNamePrefix ? name : displayName;
const nameDetails = hasNamePrefix ? displayName.slice(name.length).trim() : '';
---

<Layout {meta}>
  <article class="bg-slate-50 px-5 py-10 dark:bg-slate-900 sm:px-8 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <a
        href="/mme/analyst"
        class="mb-8 inline-flex items-center gap-2 rounded text-sm font-medium text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 dark:text-blue-300"
      >
        <span aria-hidden="true">←</span> 返回分析師列表
      </a>

      <header class="grid items-center gap-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-10 md:grid-cols-[280px_1fr] md:gap-12">
        {imageWidth && imageHeight ? (
          <img
            src={image}
            alt={name ? `${name}的個人照片` : '分析師照片'}
            width={imageWidth}
            height={imageHeight}
            class="mx-auto h-auto w-full max-w-[280px] rounded-2xl"
          />
        ) : (
          <div class="mx-auto flex aspect-[2/3] w-full max-w-[280px] items-center justify-center rounded-2xl bg-slate-100 text-sm text-slate-500 dark:bg-slate-700 dark:text-slate-300">
            照片待補
          </div>
        )}
        <div class="min-w-0 text-center md:text-left">
          <p class="mb-3 text-sm font-semibold tracking-widest text-primary dark:text-blue-300">分析師介紹</p>
          <h1 class="break-words text-4xl font-bold leading-tight text-slate-900 dark:text-white sm:text-5xl">{headingName || '分析師'}</h1>
          {nameDetails && (
            <p class="mt-3 break-words text-base leading-relaxed text-slate-500 dark:text-slate-300 sm:text-lg">{nameDetails}</p>
          )}
        </div>
      </header>

      {qualifications.length > 0 && (
        <section aria-labelledby="qualifications-heading" class="mt-12">
          <h2 id="qualifications-heading" class="mb-6 text-2xl font-bold text-slate-900 dark:text-white">專業背景與資歷</h2>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800 sm:p-8">
            <ul class="space-y-4">
              {qualifications.map((item) => (
                <li class="flex gap-3 text-base leading-7 text-slate-600 dark:text-slate-300">
                  <span aria-hidden="true" class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-400" />
                  <span class="min-w-0 break-words">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>
